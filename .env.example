# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret for signing admin authentication tokens
JWT_SECRET="glamirk_luxury_atelier_jwt_secret_2026"

# DATABASE_URL: Neon Postgres connection string. Get this from your Neon
# project dashboard (neon.tech) -> Connection Details -> Connection string.
# Must include sslmode=require (Neon requires SSL).
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require"

# CLOUDINARY_URL: durable storage for admin-uploaded media (product/blog images).
# Get this from your Cloudinary dashboard (cloudinary.com) -> API Keys ->
# "API Environment variable" field.
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# --- Email delivery (customer "Forgot Password" reset links) ---
# Optional. Without these, the reset-password endpoint falls back to
# dev-mode: it returns the reset token directly in the API response instead
# of emailing it, so the flow still works end-to-end without SMTP configured.
# Once these are set, real reset emails are sent via nodemailer.
# Any SMTP provider works (Gmail app password, SendGrid, Mailgun, Resend SMTP, etc).
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="apikey_or_username"
SMTP_PASS="smtp_password_or_api_key"
SMTP_FROM="Glamirk Beauty <care@glamirk.com>"

# --- "Continue with Google" customer sign-in ---
# Optional. Without this, the Google button shows "coming soon" and customers
# use email/password instead — nothing else breaks.
# Get this from Google Cloud Console -> APIs & Services -> Credentials ->
# Create Credentials -> OAuth client ID -> Application type: Web application.
# Under "Authorized JavaScript origins" add this app's URL (e.g.
# http://localhost:3000 for local dev, and your production domain).
# Must be prefixed VITE_ so the browser bundle can read it.
VITE_GOOGLE_CLIENT_ID="123456789-abcdefg.apps.googleusercontent.com"

