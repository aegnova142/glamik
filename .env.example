# ============================================================
# A SINGLE .env AT THE REPO ROOT SERVES EVERY WORKSPACE.
# The backend loads it by absolute path (backend/src/config/env.ts), so it
# works no matter which directory the process is started from — npm scripts,
# pm2, or a bare `node backend/dist/server.cjs`.
# Copy this file to `.env` and fill in the values.
# ============================================================

# PORT: port the backend listens on. It serves the API, the storefront (/)
# and the admin panel (/admin) from this one port. Defaults to 3000.
PORT="3000"

# GEMINI_API_KEY: currently UNUSED. The dependency is installed and this key is
# still wired through deploy config, but nothing in the codebase calls Gemini —
# the beauty assistant is rule-based, and skin analysis runs on-device via
# MediaPipe. Left in place so enabling a Gemini feature later needs no
# infrastructure change. Safe to leave blank.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
# The literal "MY_APP_URL" is treated as UNSET by the code, so an untouched
# copy of this file does not produce links to a hostname that does not exist.

# SITE_URL: absolute origin used by the sitemap and robots.txt routes only.
# Optional — defaults to https://glamirk.com. Set it if the storefront is served
# from another domain, or sitemap.xml will advertise the wrong one.
# SITE_URL="https://glamirk.com"

# ADMIN_HOST: hostname the admin back office is served from, e.g.
# "admin.glamirk.com". Leave blank/unset to keep the original layout, where
# admin lives at /admin on the same host as the storefront.
#
# When set:
#   - the admin app is served at the ROOT of this hostname
#   - /admin on the storefront host 302-redirects here
#   - the storefront host stops serving the admin bundle entirely
#
# No CORS setup is needed either way: the API answers on every hostname this
# process serves, so the admin's relative /api calls and its socket connection
# stay same-origin.
#
# This value is read at BUILD time too (it decides the admin bundle's asset
# base path), so it must be set for `npm run build`, not just at runtime.
# Changing it requires a rebuild, not just a restart.
#
# Before setting this in production, make sure BOTH are true:
#   1. DNS: an A/CNAME record for the subdomain points at this server
#   2. TLS: the certificate covers the subdomain (or is a wildcard), and the
#      reverse proxy in front has a server block accepting that hostname
# Setting it before those are ready takes the back office offline.
ADMIN_HOST=""

# JWT_SECRET: signs admin sessions, customer sessions, and (unless
# OTP_HASH_SECRET is set separately) the stored OTP hashes.
#
# Generate your own — do NOT copy a value from here or from any example:
#
#   openssl rand -hex 32
#
# Left empty on purpose. In production the app REFUSES TO START without it
# rather than falling back to a default, because a fallback committed to this
# repository would make every session forgeable by anyone who can read the
# code. Locally it falls back to a clearly-named development key.
#
# Changing this signs out every logged-in customer and admin.
JWT_SECRET=""

# DATABASE_URL: Postgres connection string.
#
# Production uses Neon: get it from the Neon dashboard (neon.tech) ->
# Connection Details -> Connection string. Must include sslmode=require.
#
# A local Postgres works too — TLS is negotiated for managed providers and
# skipped automatically for localhost, so no extra configuration is needed:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/glamirk"
#
# Schema is applied automatically at boot from database/migrations. To set up
# an empty database explicitly: `npm run migrate && npm run seed`.
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require"

# CLOUDINARY_URL: durable storage for admin-uploaded media (product/blog images).
# Get this from your Cloudinary dashboard (cloudinary.com) -> API Keys ->
# "API Environment variable" field.
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# --- Image & video upload limits (optional) ---
# All three have working defaults; set them only to deviate.
#
# MEDIA_MAX_IMAGE_MB  (default 20) Largest image an admin may upload. Applied
#                     once the file's magic bytes have confirmed it IS an
#                     image, so a photo is never judged against the video
#                     ceiling. 20 MB comfortably covers an uncompressed
#                     product shot; the stored original is kept at full
#                     quality and every delivered size is derived from it.
# MEDIA_MAX_VIDEO_MB  (default 60) Largest video. Also the hard ceiling multer
#                     enforces on the raw request, because it has to choose a
#                     single number before knowing the file's type — so this
#                     must be >= MEDIA_MAX_IMAGE_MB.
# MEDIA_ALLOW_SVG     (default true) Whether SVG uploads are accepted. The
#                     site logo and favicon are SVGs uploaded through this
#                     pipeline, so turning this off will stop an admin from
#                     replacing them. SVG is never stored as received: script
#                     elements, event handlers, javascript: URIs, foreignObject
#                     and entity declarations are stripped first. Set to
#                     "false" to refuse SVG entirely.
#MEDIA_MAX_IMAGE_MB="20"
#MEDIA_MAX_VIDEO_MB="60"
#MEDIA_ALLOW_SVG="true"

# --- Email delivery (customer "Forgot Password" reset links) ---
# Optional. Without these, the reset-password endpoint falls back to
# dev-mode: it returns the reset token directly in the API response instead
# of emailing it, so the flow still works end-to-end without SMTP configured.
# Once these are set, real reset emails are sent via nodemailer.
# Any SMTP provider works (Gmail app password, SendGrid, Mailgun, Resend SMTP, etc).
#
# LEAVE THESE BLANK until you have real credentials. They used to ship with
# plausible-looking fake values, and a deployment that copied this file without
# filling them in looked configured: a transport was built against the literal
# smtp.example.com, every message failed with ENOTFOUND, and each one burned
# five retries before being marked FAILED. Blank fails closed instead — the
# email channel reports SKIPPED and says why, which is the truth.
#
# Fill all three of HOST/USER/PASS or none of them; a partial block counts as
# unconfigured.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Glamirk Beauty <care@glamirk.com>"

# Suppresses delivery while still composing the message. Optional — and not
# needed under NODE_ENV=test, which already suppresses delivery on its own.
#
# Note the ORDER of the checks in mailer.ts: SMTP must still be CONFIGURED for a
# message to be composed at all, so setting this alone is not enough to exercise
# an email flow — the SMTP_ values above have to be present too, and REAL. The
# placeholder values this file used to ship no longer count as configured, so a
# flow exercised with them composes nothing.
# EMAIL_DELIVERY_DISABLED="true"

# --- Email-address verification by six-digit code (all optional; defaults shown) ---
# The My Profile email verification screen. Mirrors the phone OTP policy below.

# How long a code stays valid, in seconds. Longer than the phone OTP on purpose:
# a code that expires while the mail is still in transit is a support ticket.
EMAIL_CODE_EXPIRY_SECONDS="600"

# Wrong guesses against ONE code before it dies. A six-digit space needs this
# cap to be small or it can simply be walked.
EMAIL_CODE_MAX_ATTEMPTS="5"

# Minimum gap between sends — what the countdown on the screen counts down.
EMAIL_CODE_RESEND_COOLDOWN_SECONDS="60"

# ============================================================
# --- Customer sign-in by mobile + OTP ---
#
# This is the PRIMARY customer sign-in. Until at least one channel below is
# configured, customers cannot sign in with a mobile number at all — the
# server refuses to send and says so, rather than pretending a code went out.
# Email + password sign-in keeps working regardless, so an unconfigured OTP
# channel degrades the store, it doesn't close it.
#
# The server logs which channels are live at boot. Admin sign-in is a
# completely separate system and is unaffected by everything in this block.
# ============================================================

# --- Master switch for OTP SIGN-IN availability ---
# SCOPE: mobile OTP sign-in ONLY. This flag has no effect whatsoever on
# WhatsApp or email ORDER NOTIFICATIONS — those are governed by their own
# credentials further down, deliberately, so sign-in configuration can never
# switch order updates on or off.
#
# Blank (the default) means mobile sign-in reports itself unavailable:
# /api/customer/auth/otp/channels answers sms:false and the sign-in screen
# refuses the number instead of accepting one it cannot send to. No OTP is
# handed to any third party on any code path, whatever SMS_PROVIDER and the
# credentials below say.
#
# Off by default on purpose: the alternative is relying on the provider names
# being blank, which re-enables a vendor the moment someone pastes
# credentials back in. Code generation, hashing, expiry, rate limits and
# verification are untouched by this — it only decides whether mobile sign-in
# is offered at all.
#
# NOTE FOR FIREBASE MODE: this flag still gates the channel even though the
# backend sends nothing itself — Google sends the SMS from the browser. So
# with SMS_PROVIDER="firebase" this must ALSO be set, or mobile sign-in stays
# dark with everything else configured correctly.
#
# Set to true, per environment and deliberately, to offer mobile sign-in.
OTP_DELIVERY_ENABLED=""

# --- Local development: OTP to the console instead of by SMS ---
# Set OTP_DEV_MODE=1 to print sign-in codes to the server console and send no
# SMS at all. Lets the whole mobile sign-in flow be tested with no provider
# account, no DLT template and no real handset.
#
# Everything else is unchanged: the code is still generated server-side,
# stored only as a keyed hash, still expires on OTP_EXPIRY_SECONDS, still
# single-use, and still subject to the attempt cap, the resend cooldown and
# both quotas. Only the delivery transport is replaced.
#
# Requires BOTH of:
#   NODE_ENV=development   (exactly this string — an unset NODE_ENV will NOT
#                           enable it, so a misconfigured server fails closed)
#   OTP_DEV_MODE=1         (or true/yes/on)
#
# In production the flag is ignored entirely and the server says so at boot.
# Leave this BLANK in any deployed environment.
OTP_DEV_MODE=""

# --- SMS ---
# Set to "firebase" for mobile OTP sign-in. There is no server-side SMS vendor:
# the browser talks to Google directly and this backend never carries a code —
# see the Firebase block below. Leave blank to disable SMS OTP.
# Ignored while OTP_DEV_MODE is active.
SMS_PROVIDER=""


# Firebase Phone Auth — set SMS_PROVIDER="firebase" to select it.
#
# The one provider that needs no DLT registration in India: Google sends the
# SMS and checks the code, so this backend generates nothing. Its own
# issue/verify endpoints refuse with a 409 in this mode rather than pretending
# to send, and the browser exchanges the resulting ID token for a Glamirk
# session at /api/customer/auth/otp/firebase/verify.
#
# FIREBASE_PROJECT_ID is server-side: verifyIdToken validates the token's
# aud/iss against it. No service account is needed or wanted — verification
# only requires the project id and Google's public certificates.
FIREBASE_PROJECT_ID=""

# The VITE_ values are PUBLIC by design: Firebase expects them in the browser
# bundle. They are read at BUILD time, so they must be set before
# `npm run build` runs, not just at runtime. Get them from the Firebase console
# -> Project settings -> Your apps -> SDK setup and configuration.
#
# Before this works, in the Firebase console: Authentication -> Sign-in method
# -> enable Phone, and add this site's domain under Authorized domains.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""


# --- WhatsApp (ORDER NOTIFICATIONS ONLY) ---
# WhatsApp carries order updates — placed, shipped, delivered, cancelled. It is
# NOT an OTP transport: sign-in codes go through Firebase Phone Auth and
# nowhere else. Nothing here is reachable from the authentication path.
#
# Leave these blank to disable WhatsApp notifications; the notification engine
# then skips the channel with a reason instead of reporting a false success.
#
# From Meta for Developers -> your app -> WhatsApp -> API Setup:
#   WHATSAPP_PHONE_NUMBER_ID  - "Phone number ID" on that page
#   WHATSAPP_ACCESS_TOKEN     - a PERMANENT System User token, not the 24h
#                               temporary one shown by default
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v21.0"

# Graph API host. Optional — defaults to https://graph.facebook.com. Override
# only to point at a local test double; every call carries the access token
# above, so anything this resolves to receives that credential.
# WHATSAPP_API_BASE_URL="https://graph.facebook.com"

# Approved templates, one per notification event.
#
# Meta refuses free-form messages to a customer who has not messaged you first,
# so every order update must name a pre-approved template of category UTILITY.
# An OTP template (category AUTHENTICATION) CANNOT be reused here — Meta
# rejects the send, and misusing an auth template is what gets a number
# rate-limited.
#
# An event with no template set is skipped and recorded as such, never guessed
# at. The variable name is the event type verbatim; template body parameters
# are filled in order as {{1}} = order number, {{2}} = customer name.
#
# These are the events routed to WhatsApp (see EVENT_CHANNELS in
# notificationEngine.service.ts). Every other event is in-app and email only.
WHATSAPP_ORDER_TEMPLATE_ORDER_PLACED=""
WHATSAPP_ORDER_TEMPLATE_ORDER_CONFIRMED=""
WHATSAPP_ORDER_TEMPLATE_ORDER_SHIPPED=""
WHATSAPP_ORDER_TEMPLATE_ORDER_OUT_FOR_DELIVERY=""
WHATSAPP_ORDER_TEMPLATE_ORDER_DELIVERED=""
WHATSAPP_ORDER_TEMPLATE_REFUND_COMPLETED=""
WHATSAPP_ORDER_TEMPLATE_LANGUAGE="en_US"

# Store-side alert when an order comes in. The destination number is NOT an env
# var — set it under Admin → Settings → WhatsApp order number.
WHATSAPP_ORDER_TEMPLATE_ADMIN_NEW_ORDER=""


# --- OTP policy (all optional; these are the defaults) ---

# How long a code stays valid, in seconds. The backend compares against the
# stored expires_at using its own clock, so the browser countdown is display
# only and cannot extend this.
OTP_EXPIRY_SECONDS="60"

# Wrong guesses allowed against ONE code before that code is killed. Hitting
# this does not lock the phone number — the customer requests a new code,
# subject to the cooldown and the daily quota below.
OTP_MAX_ATTEMPTS="5"

# Minimum gap between two sends to the same number. Matches the expiry by
# default, so the natural flow is: send -> 60s validity -> expires -> resend
# unlocks.
OTP_RESEND_COOLDOWN_SECONDS="60"

# OTP REQUESTS per phone number per ROLLING 24 hours (not a midnight reset —
# each request stops counting once it is itself 24h old). SMS and WhatsApp
# share this one allowance, so switching channel cannot buy a fresh budget.
# Failed verification attempts do NOT consume it; only sends do. A send that
# the provider rejects is refunded, since the customer never got anything.
OTP_MAX_PER_PHONE_PER_24H="5"

# Supporting limits only, all per IP address. Deliberately far looser than the
# per-number quota because households, offices, hostels and mobile carrier
# NATs legitimately share one address — tightening these enough to matter on
# their own would also lock out real customers. The per-number quota above is
# the actual defence.
#
#   OTP_MAX_PER_IP_PER_HOUR    sustained sends from one address per hour
#   OTP_REQUEST_BURST_PER_IP   sends from one address per burst window
#   OTP_VERIFY_BURST_PER_IP    verification attempts per burst window
#   OTP_IP_BURST_WINDOW_MINUTES  length of that burst window
OTP_MAX_PER_IP_PER_HOUR="30"
OTP_REQUEST_BURST_PER_IP="30"
OTP_VERIFY_BURST_PER_IP="50"
OTP_IP_BURST_WINDOW_MINUTES="15"

# Optional: secret used to hash stored OTPs. Defaults to JWT_SECRET, which is
# fine. Set this only to rotate OTP hashing independently of session signing —
# changing it invalidates codes at most 5 minutes old, so there is nothing to
# migrate.
OTP_HASH_SECRET=""

# ==========================================================================
# PAYMENTS — RAZORPAY
# ==========================================================================
#
# BOTH flags below default to OFF. With PAYMENTS_LIVE_MODE unset or false the
# app runs on a built-in mock gateway: the complete checkout -> pay -> verify
# -> webhook path works end to end, no packet reaches Razorpay, and no
# customer can be charged. This is what lets the integration be developed and
# tested safely.
#
# Going live needs BOTH the flag AND real credentials. Setting the flag alone
# leaves the mock in place and logs a warning at boot — a half-configured
# gateway never reaches customers.
#
# In production the online payment option is hidden entirely unless live mode
# is on with credentials present, so the storefront stays Cash-on-Delivery
# only until you deliberately switch over.
PAYMENTS_LIVE_MODE="false"

# From Razorpay Dashboard -> Settings -> API Keys.
# KEY_ID is public (the browser checkout needs it). KEY_SECRET is NOT and is
# never sent to a browser or written to a log.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# From Razorpay Dashboard -> Settings -> Webhooks, when you create the webhook.
# Point the webhook at:  https://your-domain.com/api/webhooks/razorpay
# Subscribe to: payment.captured, payment.failed, refund.created, refund.processed
#
# Without this, webhooks are rejected as unverifiable. Payments still work
# (the browser verify call confirms them), but you lose the safety net that
# catches a customer closing the tab mid-payment.
RAZORPAY_WEBHOOK_SECRET=""

# Development-only escape hatch: set to any value to offer the mock gateway as
# a real checkout option locally. Ignored in production.
PAYMENTS_MOCK_CHECKOUT=""

# ==========================================================================
# INVENTORY
# ==========================================================================
#
# Stock originally lived inside the cms_state JSONB document. Migration 012
# creates dedicated SQL inventory tables and copies the numbers across, but
# changes nothing about which system is in charge.
#
# OFF by default: the legacy JSONB document stays the single source of truth
# and every stock check behaves exactly as it does today. The SQL tables are
# populated and verifiable but gate nothing.
#
# CUTOVER PROCEDURE:
#   1. Apply migration 012.
#   2. npm run inventory:verify   -- must report "systems agree"
#   3. Set INVENTORY_SQL_MODE=true and restart.
#   4. npm run inventory:verify   -- confirm they still agree under live traffic.
#
# ROLLBACK: set INVENTORY_SQL_MODE=false and restart. Because the legacy
# document is mirrored on every mutation (see INVENTORY_MIRROR_LEGACY below),
# it is already current -- there is nothing to restore.
INVENTORY_SQL_MODE="false"

# Whether the legacy JSONB document is still written alongside SQL inventory.
# Leave this on until SQL has been authoritative in production long enough to
# trust: it is what makes the rollback above a flag flip rather than a restore
# from backup. Turning it off drops the safety net, so only do so deliberately
# -- and run `npm run inventory:rollback -- --confirm` first if you ever need
# to bring the stale document back in line.
INVENTORY_MIRROR_LEGACY="true"

# How long an unpaid online order may hold its stock before the sweep releases
# it. Too short and a slow payer loses their basket; too long and one abandoned
# checkout keeps the last unit off sale.
INVENTORY_RESERVATION_MINUTES="30"

# ==========================================================================
# SHIPPING — DELHIVERY ONE (B2C)
# ==========================================================================
#
# The active shipping provider. Delhivery carries the parcel itself, so there
# is no rate shopping and no courier to choose: waybills are drawn from your
# pool before a shipment exists, and pickups are booked per warehouse per day.
#
# Same two-key arrangement as payments. With DELHIVERY_LIVE_MODE off a mock
# courier answers and NO real waybill, shipment or pickup is ever created.
DELHIVERY_LIVE_MODE="false"

# API host. Validated at startup: HTTPS and a delhivery.com host only,
# because whatever this resolves to receives your API token on every request.
DELHIVERY_BASE_URL="https://track.delhivery.com"

# Delhivery One -> Settings -> API Setup -> Existing API Token.
# Sent as "Authorization: Token <value>". Backend-only — never a VITE_* var.
# Note: generating a new token kills the old one IMMEDIATELY, so rotate in a
# planned window and update every environment at once.
DELHIVERY_TOKEN=""

# Registered warehouse name, EXACTLY as Delhivery holds it — case and spaces
# included. Delhivery One -> Settings -> Warehouses.
# No default on purpose: a guess here turns a configuration gap into a run of
# rejected shipments, and the API error for it is unhelpfully generic.
DELHIVERY_PICKUP_NAME=""

# Printed on the shipping label as the sender.
DELHIVERY_SELLER_NAME="Glamirk Beauty"
DELHIVERY_SELLER_ADDRESS=""

# Daily collection slot, HH:MM:SS.
DELHIVERY_PICKUP_TIME="14:00:00"

# Scan Push webhook. Delhivery configures and tests this through its own
# webhook request process — the endpoint below is ready, but nothing arrives
# until Delhivery has approved it.
#   URL     https://your-domain.com/api/webhooks/delhivery
#   Method  POST
#   Header  x-api-key: <this value>
# Generate with: openssl rand -hex 32
# Left empty the endpoint rejects every delivery, in every environment.
DELHIVERY_WEBHOOK_SECRET=""

# Fallback parcel dimensions for products with no shipping weight recorded.
DELHIVERY_DEFAULT_WEIGHT_KG="0.3"
DELHIVERY_DEFAULT_LENGTH_CM="15"
DELHIVERY_DEFAULT_BREADTH_CM="10"
DELHIVERY_DEFAULT_HEIGHT_CM="5"
