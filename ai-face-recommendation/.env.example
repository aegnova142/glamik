# ============================================================================
# Glamrik AI service — configuration
#
# Copy to .env and fill in. Secrets are NEVER committed and never baked into
# the Docker image; they are supplied at runtime by the orchestrator.
# ============================================================================

# --- service ---
HOST=0.0.0.0
PORT=8001
# development | production. Production disables /docs and /openapi.json.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
# Gunicorn workers. Recommended starting point is (CPU cores / 2), because
# every worker holds its own copy of the models in memory.
WEB_CONCURRENCY=2

# --- authentication ---
# Presented by the Node backend as the X-Internal-AI-Key header on every
# protected endpoint. This service has no other authentication, so treat this
# value as a production secret.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_KEY=change-this-internal-key
INTERNAL_API_KEY_HEADER=X-Internal-AI-Key

# --- Node backend (source of truth for the catalog; Phase 2) ---
NODE_BACKEND_URL=http://localhost:3000
NODE_CONNECT_TIMEOUT=3.0
NODE_READ_TIMEOUT=10.0
NODE_WRITE_TIMEOUT=10.0
NODE_TOTAL_TIMEOUT=15.0
NODE_MAX_CONNECTIONS=32
NODE_MAX_RETRIES=2

# --- redis (optional) ---
# Caching is keyed by image content hash plus model versions. Leave blank to
# disable: the service runs correctly without Redis, just without caching and
# without rate limiting.
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_ENABLED=true

# --- uploads ---
MAX_UPLOAD_MB=5
MAX_IMAGE_DIMENSION=640
# Try-on renders an image a customer looks at rather than taking a measurement
# from it, so it works at a higher resolution than analysis.
TRYON_MAX_DIMENSION=1024
# Decompression-bomb ceiling on DECODED pixels, independent of file size.
MAX_DECODED_PIXELS=40000000

# --- analysis thresholds ---
# Below this confidence the service returns RETAKE_PHOTO instead of presenting
# an uncertain estimate as a measurement.
MIN_CONFIDENCE=0.45
MAX_YAW_DEGREES=15.0
MAX_PITCH_DEGREES=15.0

# --- observability ---
# Sentry is optional. PII sending is disabled in code and cannot be turned on
# by configuration — this service handles face photographs.
SENTRY_DSN=
METRICS_ENABLED=true

# --- CORS ---
# Empty by default: this is a server-to-server service and no browser should
# call it directly. Comma-separated origins if that ever changes.
CORS_ORIGINS=

# --- models ---
MODEL_DIR=./models

# --- phases ---
# Both are implemented. They return NOT_IMPLEMENTED while these are false, so
# enabling a phase is an explicit deployment decision rather than something
# that happens the moment the code lands.
ENABLE_RECOMMENDATION=false
ENABLE_TRYON=false
