{
  "name": "@glamirk/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Glamirk API — Express server that also serves the built storefront and admin bundles.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --sourcemap --outfile=dist/server.cjs --external:express --external:pg --external:bcryptjs --external:jsonwebtoken --external:nodemailer --external:cloudinary --external:multer --external:socket.io --external:dotenv --external:vite",
    "start": "node dist/server.cjs",
    "migrate": "tsx src/db/cli-migrate.ts",
    "seed": "tsx src/db/cli-seed.ts",
    "lint": "tsc --noEmit",
    "test": "tsx src/test/checkout.e2e.ts",
    "test:inventory": "tsx src/test/inventory.e2e.ts",
    "test:cmsstate": "tsx src/test/cmsstate.e2e.ts",
    "test:migration013": "tsx src/test/migration013.e2e.ts",
    "test:migrationsafety": "tsx src/test/migrationsafety.e2e.ts",
    "test:mirror": "tsx src/test/mirror.e2e.ts",
    "inventory:verify": "tsx src/db/cli-inventory.ts verify",
    "inventory:health": "tsx src/db/cli-inventory.ts health",
    "inventory:mirror-check": "tsx src/db/cli-inventory.ts mirror-check",
    "shiprocket:check": "tsx src/db/cli-shiprocket.ts",
    "inventory:inspect": "tsx src/db/cli-inspect-production.ts",
    "inventory:validate": "tsx src/db/cli-validate-migration.ts",
    "inventory:resync": "tsx src/db/cli-inventory.ts resync",
    "inventory:rollback": "tsx src/db/cli-inventory.ts rollback",
    "inventory:repair-flags": "tsx src/db/cli-inventory.ts repair-flags"
  },
  "dependencies": {
    "@glamirk/shared": "*",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.3"
  }
}
