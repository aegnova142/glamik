{
  "name": "glamirk",
  "private": true,
  "version": "1.0.0",
  "description": "Glamirk Beauty — luxury beauty e-commerce monorepo (storefront, admin, API).",
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "admin"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @glamirk/backend",
    "build": "npm run build --workspace @glamirk/frontend && npm run build --workspace @glamirk/admin && npm run build --workspace @glamirk/backend",
    "start": "npm run start --workspace @glamirk/backend",
    "lint": "npm run lint --workspaces --if-present",
    "migrate": "npm run migrate --workspace @glamirk/backend",
    "seed": "npm run seed --workspace @glamirk/backend",
    "clean": "rimraf frontend/dist admin/dist backend/dist"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": ">=18"
  }
}
